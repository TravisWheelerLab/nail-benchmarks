*.DS_Store
/target/
# downloaded data is not tracked, but long-seqs' inputs are small and checked
# in — nothing fetches them, so ignoring them would empty a fresh clone. the
# same goes for the cutoffs mgy holds every score against: learning them is a
# calibration run, not a download
/data/*
!/data/long-seqs/
!/data/mgy-cutoffs.tbl
/tools/
# generated benchmark instances are benchmark-<size>/ or, for the crates with
# no size axis, the bare name benchmark/. The trailing dash on the first form
# matters, or this also swallows the benchmarks/ source tree.
**/benchmark-*/
**/benchmark/
# everything mgy and long-seqs build, run or work out goes in one tree at the
# root, so one line covers the sets, the runs, the analyses and the scratch.
# long-seqs' set ships with the repo rather than being built, so it sits under
# data/ and is tracked like the pairs it describes
/store/
# pid still keeps its own, since it has not moved to the store
/benchmarks/pid/inputs/
/benchmarks/pid/outputs/
# what the mgy crate wrote before the store. that crate is gone and nothing
# reads these, but a checkout that has them holds about 3.5 TB of results
# nothing can reproduce, so they stay ignored rather than offered to a commit
/benchmarks/mgy/inputs/
/benchmarks/mgy/outputs/
/benchmarks/mgy/cutoffs/
**/figures*/
**/profmark/
**/results/
# a pipeline run keeps the stderr of whatever failed, next to wherever it was
# started from
**/stderr/
**/tmp/
**/tmp-*/
**/__pycache__/
